---
import Link from "@/components/astro/Link.astro";
import Breadcrumb from "@/components/astro/Breadcrumb.astro";
import GuideCue from "@/components/astro/GuideCue.astro";
import { pageGuideCues } from "@/lib/guide-hub";
import HeroPanel from "@/components/astro/HeroPanel.astro";
import Icon from "@/components/astro/Icon.astro";
import styles from "@/style/page/tools.module.css";
const actions = [
  { title: "Compare Aniimo", body: "Put two records together when you need to choose a role, skill set, or element match.", href: "/tools/compare", icon: "database", label: "Compare records" },
  { title: "Track collection", body: "Mark the Aniimo you have discovered. Your checklist stays in this browser.", href: "/tools/collection-tracker", icon: "check", label: "Open checklist" },
  { title: "Explore spawn map", body: "Filter known spawn pins by region, Aniimo and time of day.", href: "/map", icon: "map", label: "Open map" },
  { title: "Plan a team", body: "Pick a roster and inspect its elements and roles before you play.", href: "/team-builder", icon: "team", label: "Open team builder" },
] as const;


---
<>
    <section class={styles.toolHeader}>
      <div class="container">
        <Breadcrumb items={[{ label: "Tools" }]} />
        <span class={styles.kicker}><Icon name="tools" /> Player tools</span>
        <h1>Aniimo Planning Tools</h1>
        <p>Choose a tool to compare records, track your collection, explore known spawns or plan a team.</p>
        <HeroPanel label="Choose a tool" items={["Compare Aniimo", "Track your collection", "Explore spawn maps", "Plan a team"]} />
        <GuideCue title="Guides that use these tools" items={pageGuideCues.tools} />
      </div>
    </section>
    <section class={styles.toolContent}>
      <div class="container">
        <div class={styles.toolConsole}>
          <div class={styles.consoleHeader}>
            <div><span>ANIIMO FIELD KIT</span><h2>Tools for your roster and exploration</h2></div>
            <p>Use the tools already connected to this site’s Aniimo and map records.</p>
          </div>
          <div class={styles.toolStations}>
            {actions.map((tool) => <Link href={tool.href} class={styles.toolStation}>
              <span class={styles.stationIcon}><Icon name={tool.icon} /></span>
              <div class={styles.stationCopy}>
                <h2>{tool.title}</h2>
                <p>{tool.body}</p>
              </div>
              <span class={styles.stationAction}>{tool.label} <Icon name="arrow" /></span>
            </Link>)}
          </div>
        </div>
      </div>
    </section>
  </>
