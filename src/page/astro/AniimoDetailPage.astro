---
import type { AniimoPageData } from "@/lib/aniimo-page-data";
import { elementMeta, homelandAbilityMeta, roleLabels } from "@/config/site";
import { pageGuideCues } from "@/lib/guide-hub";
import Link from "@/components/astro/Link.astro";
import Image from "@/components/astro/Image.astro";
import Icon from "@/components/astro/Icon.astro";
import Breadcrumb from "@/components/astro/Breadcrumb.astro";
import ElementBadge from "@/components/astro/ElementBadge.astro";
import GuideCue from "@/components/astro/GuideCue.astro";
import StatRadar from "@/components/astro/StatRadar.astro";
import SkillKitCard from "@/components/astro/SkillKitCard.astro";
import EvolutionNode from "@/components/astro/EvolutionNode.astro";
import SpawnMap from "@/components/astro/SpawnMap.astro";
import styles from "@/style/page/detail.module.css";

type Props = AniimoPageData;
const { entry, formViews, spawnAtlases, evolutionTree, neighbors, related, author, updated } = Astro.props;
const titleCase = (value: string) => value.replace(/\b\w/g, (char) => char.toUpperCase());
const recordSlug = (name: string) => name.toLowerCase().trim().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
const stageLabel = (stage: number) => stage === 1 ? "Lumin" : stage === 2 ? "Gamma" : stage === 3 ? "Nova" : "Special";
const formatWeight = (weight: typeof entry.weight) => weight.min == null && weight.max == null ? "" : weight.min != null && weight.max != null && weight.min !== weight.max ? `${weight.min}–${weight.max} kg` : `${weight.min ?? weight.max} kg`;
const countLineage = (node: NonNullable<typeof evolutionTree>): number => 1 + node.children.reduce((total, child) => total + countLineage(child), 0);
const baseTotal = entry.formRecords[0]?.stats?.attributeValue ?? 0;
---
<div data-aniimo-detail>
  {formViews.map((formView, formIndex) => {
    const displayed = formView.entry;
    const primary = elementMeta[displayed.elements[0]] || { color: "#4d83d9" };
    const role = displayed.roles.map((value) => roleLabels[value] || titleCase(value)).join(" / ");
    const attack = displayed.stats ? displayed.stats.physicalAttack >= displayed.stats.magicAttack ? { label: "Physical Attack", value: displayed.stats.physicalAttack } : { label: "Magic Attack", value: displayed.stats.magicAttack } : null;
    const weight = formatWeight(displayed.weight);
    const hasFieldData = displayed.traits.length > 0 || displayed.mobility.length > 0 || displayed.roles.length > 0 || Boolean(weight);
    return <div data-form-panel={formView.id} hidden={formIndex !== 0}>
      <section class={styles.detailHero} style={{ "--hero-element": primary.color }}><div class="container">
        <div class={styles.heroTop}><Breadcrumb items={[{ label: "Aniimo", href: "/aniimo" }, { label: entry.name }]} /><nav class={styles.dexNav} aria-label="Roster navigation"><Link href={`/aniimo/${neighbors.prev.slug}`} aria-label={`Previous, ${neighbors.prev.name}`}><Icon name="chevron" /></Link><span>No. {entry.entryId}</span><Link href={`/aniimo/${neighbors.next.slug}`} aria-label={`Next, ${neighbors.next.name}`}><Icon name="chevron" /></Link></nav></div>
        <article class={styles.dossier}>
          <figure class={styles.portrait}><Image src={displayed.voteImage || displayed.image} alt={`${entry.name} ${displayed.form} official artwork`} fill priority sizes="(max-width: 760px) 88vw, 420px" />{displayed.homelandAbilities.length > 0 && <ul class={styles.heroAbilities} aria-label="Homeland abilities">{displayed.homelandAbilities.map((ability) => { const meta = homelandAbilityMeta[ability.key]; const label = meta?.label || "Homeland ability"; return <li><span class={styles.heroAbility} data-ability={ability.key} title={`${label} Lv ${ability.value}`} aria-label={`${label}, level ${ability.value}`}><i /><b>{ability.value}</b></span></li>; })}</ul>}</figure>
          <div class={styles.dossierCopy}><small class={styles.entryNo}>{entry.entryId}</small><div class={styles.nameRow} data-name-row>{formIndex === 0 && <h1 data-detail-title>{entry.name}</h1>}<div class={styles.heroPills}>{displayed.elements.map((element) => <Link href={`/database/elements#${element}`} class={styles.elementPill}><ElementBadge element={element} /></Link>)}<span class={styles.stagePill} data-stage={displayed.stage}>{stageLabel(displayed.stage)} stage</span><span class={styles.formPill}>{displayed.form}</span><Link href={`/aniimo?role=${displayed.roles[0] || "all"}`} class={styles.rolePill}><Icon name="team" />{role}</Link></div></div>
            <p class={styles.description}>{displayed.description}</p><div class={styles.matchups} aria-label="Element matchups"><span class={styles.matchCaption}>Defending as {displayed.elements.map((element) => elementMeta[element]?.label || titleCase(element)).join(" / ")}</span>{(["weak", "resists", "strong"] as const).map((kind) => formView.matchups[kind].length > 0 && <div class={kind === "weak" ? styles.weakBar : kind === "resists" ? styles.resistBar : styles.strongBar}><b><Icon name={kind === "weak" ? "boss" : kind === "resists" ? "check" : "spark"} /> {kind === "weak" ? "Weak" : kind === "resists" ? "Resists" : "Strong vs"}</b><div>{formView.matchups[kind].map((element) => { const meta = elementMeta[element]; return <Link href={`/database/elements#${element}`} class={styles.typeOrb} title={meta?.label || element} aria-label={meta?.label || element} style={{ "--element-color": meta?.color || "#4d83d9", "--element-sprite-index": String(meta?.spriteIndex ?? 0) }} />; })}</div></div>)}</div>
            <p class={styles.byline}><span>Author: {author}</span><span>Updated {updated}</span></p><div class={styles.heroActions}><Link href="/team-builder" class="button-primary">Build a Team <Icon name="arrow" /></Link>{formView.findOnMapHref && <Link href={formView.findOnMapHref} class="button-secondary"><Icon name="pin" /> Find on Map</Link>}<Link href={`/tools/compare?first=${entry.slug}`} class="button-secondary">Compare</Link></div>
          </div>
        </article>
      </div></section>
      <section class={styles.detailBody}><div class="container">
        <div class={styles.overviewGrid}><section class={`${styles.panel} ${styles.ratingsPanel}`}><header><div><span class={styles.sectionEyebrow}>At a glance</span><h2>Stat Ratings at a Glance</h2></div><small>Compared with this roster</small></header><div class={styles.ratings}>{formView.ratings.map(([name, grade, icon]) => <div><i aria-hidden="true">{icon}</i><span>{name}</span><b>{grade}</b></div>)}</div><p>These letters compare base fields across the current roster. They do not settle every matchup or replace the skill descriptions.{formView.strongestStat ? ` Highest listed field: ${formView.strongestStat[0]} ${formView.strongestStat[1]}.` : ""}</p></section><section class={`${styles.panel} ${styles.statsPanel}`}><header><div><span class={styles.sectionEyebrow}>Base fields</span><h2>Base Stats</h2></div>{displayed.stats && <strong class={styles.totalStat}>{displayed.stats.attributeValue}<small>Total</small></strong>}</header>{displayed.stats ? <StatRadar stats={displayed.stats} /> : <p>Base stats are not available for this form yet.</p>}</section></div>
        <div class={styles.recordStrip} aria-label={`${entry.name} record summary`}><div><strong>{displayed.skills.length}</strong><span>Skills</span></div><div><strong>{displayed.traits.length}</strong><span>Traits</span></div><div><strong>{entry.evolution.length}</strong><span>Evolution Nodes</span></div><div><strong>{displayed.habitats.length}</strong><span>Habitats</span></div><div><strong>{displayed.mobility.length || displayed.pathfinding.length}</strong><span>Mobility Skills</span></div></div>
        <div class={styles.abilityGrid}><section class={styles.panel}><header><div><span class={styles.sectionEyebrow}>Combat Kit</span><h2>Skills, Element Types and Power</h2></div><Link href="/database/skills">Browse Skills <Icon name="arrow" /></Link></header>{displayed.skills.length ? <div class={styles.skillList}>{displayed.skills.map((skill) => <SkillKitCard skill={skill} />)}</div> : <p>Skills are not listed for this Aniimo yet.</p>}</section></div>
        {hasFieldData && <section class={styles.fieldData} aria-label={`${entry.name} field data`}><header><div><span>Trait · Mobility · Role · Size</span><h2>Field data</h2></div><Link href="/database/traits">Browse Traits <Icon name="arrow" /></Link></header>{(displayed.traits.length > 0 || displayed.mobility.length > 0) && <div class={styles.fieldFacts}>{displayed.traits.map((trait) => <Link href={`/database/traits#trait-${recordSlug(trait.name)}`} aria-label={`Open ${trait.name} in the traits database`}><span class={styles.fieldFactIcon}>{trait.iconUrl ? <Image src={trait.iconUrl} alt="" width={44} height={44} /> : <span aria-hidden="true">✧</span>}</span><div><h3>{trait.name}</h3><b>Trait</b><p>{trait.description}</p></div></Link>)}{displayed.mobility.map((ability) => <Link href={`/database/mobility#${recordSlug(ability.name)}`} aria-label={`Open ${ability.name} in the mobility database`}><span class={`${styles.fieldFactIcon} ${styles.fieldMobilityIcon}`}>{ability.iconUrl ? <Image src={ability.iconUrl} alt="" width={44} height={44} /> : <Icon name="map" />}</span><div><h3>{ability.name}</h3><b>Mobility</b><p>{ability.description}</p></div></Link>)}</div>}{displayed.pathfinding.length > 0 && <div class={styles.pathfindingTags}>{displayed.pathfinding.map((ability) => <span>{ability}</span>)}</div>}{(displayed.roles.length > 0 || attack || weight) && <div class={styles.fieldPills}>{displayed.roles.map((value) => <span data-kind="role">{roleLabels[value] || titleCase(value)}</span>)}{attack && <span data-kind="attack">{attack.label} {attack.value}</span>}{weight && <span data-kind="size">Weight {weight}</span>}</div>}</section>}
        <div class={styles.fieldDataGrid}><section class={styles.recordSection}><header class={styles.recordHeader}><h2>Habitats</h2></header>{formView.habitatLinks.length > 0 ? <div class={styles.habitatLinks}>{formView.habitatLinks.map(({ name, href }) => <Link href={href}><Icon name="pin" />{name}</Link>)}</div> : <p class={styles.habitatNote}>{formView.habitatNote?.text || "No published wild habitat."}{formView.habitatNote && <> <Link href={formView.habitatNote.href}>{formView.habitatNote.label}</Link></>}</p>}</section></div>
      </div></section>
    </div>;
  })}
  {spawnAtlases.length > 0 && <section class={styles.detailBody}><div class="container"><SpawnMap name={entry.name} atlases={spawnAtlases} /></div></section>}
  {evolutionTree && entry.evolution.length > 0 && <section class={styles.detailBody}><div class="container"><section id="lineage" class={styles.evolutionSection} style={{ "--hero-element": elementMeta[entry.elements[0]]?.color || "#4d83d9" }}><header><div><span class={styles.sectionEyebrow}>Lineage</span><h2>Evolution Path</h2></div><p>{countLineage(evolutionTree)} published stages. The highlighted medal is this profile.</p></header><div class={styles.evolutionTree}><EvolutionNode node={evolutionTree} currentName={entry.name} /></div></section></div></section>}
  {entry.formRecords.length > 1 && <section class={styles.detailBody}><div class="container"><section id="forms" class={styles.formComparison} aria-label={`${entry.name} form comparison`}><header><div><span class={styles.sectionEyebrow}>Forms</span><h2>Forms and Differences</h2></div><p>Compare each form’s elements, role, base fields and combat kit at a glance.</p></header><div class={styles.formComparisonRows}>{entry.formRecords.map((record, index) => { const total = record.stats?.attributeValue ?? 0; const delta = total - baseTotal; const fields = record.stats ? [["HP", record.stats.hp], ["P. ATK", record.stats.physicalAttack], ["M. ATK", record.stats.magicAttack], ["P. DEF", record.stats.physicalDefense], ["M. DEF", record.stats.magicDefense], ["REGEN", record.stats.haste]] : []; return <button type="button" data-select-form={record.id} class={index === 0 ? styles.currentFormComparison : undefined} aria-pressed={index === 0}><header><span class={styles.formPortrait}><Image src={record.image} alt={`${entry.name} ${record.form}`} fill sizes="112px" /></span><div><strong>{record.form}</strong><small>{stageLabel(record.stage)} stage</small></div></header><div class={styles.formIdentity}><span>{record.elements.map(titleCase).join(" / ")}</span><span>{record.roles.map((value) => roleLabels[value] || titleCase(value)).join(" / ")}</span></div><div class={styles.formTotals}><b>{total}<small> Base total</small></b><em>{delta === 0 ? "Base form" : `${delta > 0 ? "+" : ""}${delta} vs base`}</em></div><dl>{fields.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl><footer>{record.skills.length} skills <span /> {record.traits.length} trait{record.traits.length === 1 ? "" : "s"}</footer></button>; })}</div></section></div></section>}
  <section class={styles.detailBody}><div class="container">{related.length > 0 && <section class={styles.relatedSection} aria-label={`Aniimo related to ${entry.name}`}><header><div><span class={styles.sectionEyebrow}>Nearby records</span><h2>Related Aniimo</h2></div><p>Family first, then shared elements or roles.</p></header><div class={styles.relatedCards}>{related.map((item) => <Link href={`/aniimo/${item.slug}`}><span><Image src={item.image} alt="" fill sizes="120px" /></span><strong>{item.name}</strong><small>{item.caption}</small></Link>)}</div></section>}<GuideCue title="Guides for this profile" items={pageGuideCues.aniimoProfile} /></div></section>
</div>
<style is:global>[data-form-panel][hidden]{display:none!important}</style>
<script>
  import styles from "@/style/page/detail.module.css";
  const root = document.querySelector<HTMLElement>("[data-aniimo-detail]");
  if (root) root.addEventListener("click", (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>("[data-select-form]");
    if (!button) return;
    const id = button.dataset.selectForm;
    const title = root.querySelector<HTMLHeadingElement>("[data-detail-title]");
    const selectedPanel = [...root.querySelectorAll<HTMLElement>("[data-form-panel]")].find((panel) => panel.dataset.formPanel === id);
    if (title && selectedPanel) selectedPanel.querySelector<HTMLElement>("[data-name-row]")?.prepend(title);
    for (const panel of root.querySelectorAll<HTMLElement>("[data-form-panel]")) panel.hidden = panel.dataset.formPanel !== id;
    for (const option of root.querySelectorAll<HTMLButtonElement>("[data-select-form]")) {
      const active = option.dataset.selectForm === id;
      option.setAttribute("aria-pressed", String(active));
      option.classList.toggle(styles.currentFormComparison, active);
    }
  });
</script>
