---
import { aniimo } from "@/lib/data";
import { elementMeta, roleLabels } from "@/config/site";
import { pageGuideCues } from "@/lib/guide-hub";
import Breadcrumb from "@/components/astro/Breadcrumb.astro";
import HeroPanel from "@/components/astro/HeroPanel.astro";
import GuideCue from "@/components/astro/GuideCue.astro";
import Link from "@/components/astro/Link.astro";
import Image from "@/components/astro/Image.astro";
import pageStyles from "@/style/page/tools.module.css";
import styles from "@/style/components/tools.module.css";
const initial = ["stellarys", "eklue", "emberpup"].map((slug) => aniimo.find((entry) => entry.slug === slug)!);
const fields = [["hp", "HP"], ["physicalAttack", "P. ATK"], ["magicAttack", "M. ATK"], ["physicalDefense", "P. DEF"], ["magicDefense", "M. DEF"], ["haste", "REGEN"]] as const;
const clientData = aniimo.map((entry) => ({ slug: entry.slug, name: entry.name, image: entry.image, elements: entry.elements, roles: entry.roles, stage: entry.stage, form: entry.form, stats: entry.stats, skills: entry.skills.length, habitats: entry.habitats.length }));
---
<section class={pageStyles.toolHeader}><div class="container"><Breadcrumb items={[{ label: "Tools", href: "/tools" }, { label: "Compare" }]} /><h1>Compare Aniimo</h1><p>Put up to three Aniimo side by side when you are choosing a role, skill set or element for a team slot.</p><HeroPanel label="Compare with purpose" items={["Choose up to three Aniimo", "Read roles and base fields", "Open the one that fits"]} /><GuideCue title="What to compare against" items={pageGuideCues.compare} /></div></section>
<section class={pageStyles.toolContent}><div class="container"><div class={pageStyles.appSpacing}><div class={styles.compareApp} data-compare><section class={styles.compareStage}><header><div><span>Three-record comparison</span><h2>Compare Aniimo Stats, Elements and Roles</h2></div><p>Choose up to three official records. Their role, element labels and published fields update together.</p></header><div class={styles.compareGrid} data-compare-slots>{initial.map((entry, index) => <article style={{ "--compare-accent": elementMeta[entry.elements[0]]?.color || "#4b89c4" }}><button type="button" data-compare-slot={index} class={index === 0 ? styles.compareSlotActive : undefined}><span>Slot {String(index + 1).padStart(2, "0")}</span><b>{index === 0 ? "Choosing from list" : "Choose this slot"}</b></button><div class={styles.compareImage}><Image src={entry.image} alt={`${entry.name} official artwork`} fill sizes="260px" /></div><div class={styles.compareIdentity}><div><h3>{entry.name}</h3><small>Stage {entry.stage} · {entry.form}</small></div><Link href={`/aniimo/${entry.slug}`} aria-label={`Open ${entry.name} profile`}>↗</Link></div><div class={styles.compareTags}><span>{entry.elements.map((element) => `${elementMeta[element]?.symbol} ${elementMeta[element]?.label}`).join(" · ")}</span><strong>{entry.roles.map((role) => roleLabels[role] || role).join(" / ")}</strong></div></article>)}</div></section>
<section class={styles.comparePicker} aria-label="Choose Aniimo to compare"><header><div><span>Available Aniimo</span><h2>Choose Aniimo for Comparison</h2></div><label><span>Search roster</span><input data-compare-search placeholder="Search Aniimo…" /></label></header><div class={styles.comparePickerList}>{aniimo.map((entry) => <button type="button" data-compare-pick={entry.slug} data-name={entry.name.toLowerCase()} class={entry.slug === initial[0].slug ? styles.comparePickerCurrent : undefined} title={`Set ${entry.name} in selected slot`}><span><Image src={entry.image} alt="" fill sizes="92px" /></span><strong>{entry.name}</strong></button>)}</div></section>
<section class={styles.compareMatrix} aria-label="Official base stat comparison"><header><div><span>Published base fields</span><h2>Base Stats Comparison</h2></div><p>The blue mark identifies the largest number in each row, only among these selected Aniimo.</p></header><div data-compare-matrix><div class={styles.compareMatrixHead}><span>Field</span>{initial.map((entry) => <strong>{entry.name}</strong>)}</div>{fields.map(([field, label]) => { const values = initial.map((entry) => entry.stats?.[field] || 0); const max = Math.max(...values, 1); return <div class={styles.compareMetric}><span>{label}</span>{initial.map((_, index) => <div class={values[index] === max && values[index] > 0 ? styles.compareBest : undefined}><b>{values[index] || "—"}</b><i><em style={{ "--compare-progress": `${Math.round(values[index] / max * 100)}%` }} /></i></div>)}</div>; })}<div class={styles.compareMetric}><span>Skills</span>{initial.map((entry) => <div><b>{entry.skills.length}</b><small>published</small></div>)}</div><div class={styles.compareMetric}><span>Habitats</span>{initial.map((entry) => <div><b>{entry.habitats.length || "—"}</b><small>listed</small></div>)}</div></div></section>
<script type="application/json" data-compare-data set:html={JSON.stringify({ entries: clientData, elements: elementMeta, roles: roleLabels }).replace(/</g, "\\u003c")} />
</div></div></div></section>
<style is:global>[data-compare-pick][hidden]{display:none!important}</style>
<script>
  import styles from "@/style/components/tools.module.css";
  const root = document.querySelector<HTMLElement>("[data-compare]");
  if (root) {
    const compare = root;
    const data = JSON.parse(root.querySelector<HTMLScriptElement>("[data-compare-data]")?.textContent || "{}") as { entries: Array<{ slug: string; name: string; image: string; elements: string[]; roles: string[]; stage: number; form: string; stats: Record<string, number> | null; skills: number; habitats: number }>; elements: Record<string, { symbol: string; label: string; color: string }>; roles: Record<string, string> };
    const index = new Map(data.entries.map((entry) => [entry.slug, entry]));
    const first = new URL(location.href).searchParams.get("first");
    const slots = ["stellarys", "eklue", "emberpup"];
    if (first && index.has(first)) { slots.splice(slots.indexOf(first), 1); slots.unshift(first); slots.length = 3; }
    let active = 0;
    const search = root.querySelector<HTMLInputElement>("[data-compare-search]")!;
    const slotHost = root.querySelector<HTMLElement>("[data-compare-slots]")!;
    const matrix = root.querySelector<HTMLElement>("[data-compare-matrix]")!;
    const escape = (value: string) => String(value).replace(/[&<>"']/g, (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" } as Record<string, string>)[char]);
    const fields = [["hp", "HP"], ["physicalAttack", "P. ATK"], ["magicAttack", "M. ATK"], ["physicalDefense", "P. DEF"], ["magicDefense", "M. DEF"], ["haste", "REGEN"]] as const;
    function render() {
      const chosen = slots.map((slug) => index.get(slug)!);
      slotHost.innerHTML = chosen.map((entry, i) => `<article style="--compare-accent:${escape(data.elements[entry.elements[0]]?.color || "#4b89c4")}"><button type="button" data-compare-slot="${i}" class="${i === active ? styles.compareSlotActive : ""}"><span>Slot ${String(i + 1).padStart(2, "0")}</span><b>${i === active ? "Choosing from list" : "Choose this slot"}</b></button><div class="${styles.compareImage}"><img src="${escape(entry.image)}" alt="${escape(entry.name)} official artwork" loading="lazy"></div><div class="${styles.compareIdentity}"><div><h3>${escape(entry.name)}</h3><small>Stage ${entry.stage} · ${escape(entry.form)}</small></div><a href="/aniimo/${escape(entry.slug)}" aria-label="Open ${escape(entry.name)} profile">↗</a></div><div class="${styles.compareTags}"><span>${entry.elements.map((element) => `${escape(data.elements[element]?.symbol || "")} ${escape(data.elements[element]?.label || element)}`).join(" · ")}</span><strong>${entry.roles.map((role) => escape(data.roles[role] || role)).join(" / ")}</strong></div></article>`).join("");
      matrix.innerHTML = `<div class="${styles.compareMatrixHead}"><span>Field</span>${chosen.map((entry) => `<strong>${escape(entry.name)}</strong>`).join("")}</div>` + fields.map(([field, label]) => { const values = chosen.map((entry) => entry.stats?.[field] || 0); const max = Math.max(...values, 1); return `<div class="${styles.compareMetric}"><span>${label}</span>${values.map((value) => `<div class="${value === max && value > 0 ? styles.compareBest : ""}"><b>${value || "—"}</b><i><em style="--compare-progress:${Math.round(value / max * 100)}%"></em></i></div>`).join("")}</div>`; }).join("") + `<div class="${styles.compareMetric}"><span>Skills</span>${chosen.map((entry) => `<div><b>${entry.skills}</b><small>published</small></div>`).join("")}</div><div class="${styles.compareMetric}"><span>Habitats</span>${chosen.map((entry) => `<div><b>${entry.habitats || "—"}</b><small>listed</small></div>`).join("")}</div>`;
      compare.querySelectorAll<HTMLButtonElement>("[data-compare-pick]").forEach((button) => { button.hidden = !button.dataset.name?.includes(search.value.trim().toLowerCase()); button.classList.toggle(styles.comparePickerCurrent, button.dataset.comparePick === slots[active]); });
    }
    root.addEventListener("click", (event) => { const target = event.target as Element; const slot = target.closest<HTMLButtonElement>("[data-compare-slot]"); const pick = target.closest<HTMLButtonElement>("[data-compare-pick]"); if (slot) { active = Number(slot.dataset.compareSlot); render(); } else if (pick) { const slug = pick.dataset.comparePick!; const existing = slots.indexOf(slug); if (existing >= 0 && existing !== active) slots[existing] = slots[active]; slots[active] = slug; render(); } });
    search.addEventListener("input", render);
    render();
  }
</script>
