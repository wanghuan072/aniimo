---
import Image from "@/components/astro/Image.astro";
import Breadcrumb from "@/components/astro/Breadcrumb.astro";
import Icon from "@/components/astro/Icon.astro";
import styles from "@/style/page/content.module.css";
import updatesStyles from "@/style/page/updates.module.css";
import {
  events,
  resetSchedules,
  rewardCodes,
  seasonBoundaries,
  updateEntries,
  updatesReviewedAt,
  updatesSources,
  type ServerRegion,
} from "@/data/editorial/updates";
import { compareRelevantEvents, getCurrentSeasonBoundary, getRelevantEventPeriod } from "@/lib/update-schedule";

const buildNow = Date.now();
const defaultRegion: ServerRegion = "apac";
const eventEntries = events
  .map((event) => ({ event, relevant: getRelevantEventPeriod(event, defaultRegion, buildNow) }))
  .filter((entry) => entry.relevant !== null)
  .map((entry) => ({ event: entry.event, relevant: entry.relevant! }))
  .sort(compareRelevantEvents);
const initiallyVisibleEvents = eventEntries.slice(0, 8);
const availableCodes = rewardCodes.filter((entry) => entry.status !== "expired" && (!entry.expiresAt || Date.parse(entry.expiresAt) > buildNow));
const expiredCodes = rewardCodes.filter((entry) => !availableCodes.includes(entry));
const activeEventCount = eventEntries.filter(({ relevant }) => ["live", "ending"].includes(relevant.state)).length;
const initialSeason = getCurrentSeasonBoundary(seasonBoundaries, buildNow);
const latestUpdate = [...updateEntries].sort((a, b) => Date.parse(b.publishedAt) - Date.parse(a.publishedAt))[0];
const archiveEntries = [...updateEntries].filter((entry) => entry.slug !== latestUpdate.slug).sort((a, b) => Date.parse(b.publishedAt) - Date.parse(a.publishedAt));
const reviewedLabel = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" }).format(new Date(`${updatesReviewedAt}T00:00:00Z`));
const dateLabel = (date: string) => new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" }).format(new Date(`${date}T00:00:00Z`));
---

<section class={`${styles.compactHero} ${updatesStyles.updatesHero}`}>
  <div class="container">
    <Breadcrumb items={[{ label: "Updates" }]} />
    <div class={updatesStyles.heroGrid}>
      <div>
        <span class={styles.kicker}><Icon name="spark" /> Live companion</span>
        <h1>Aniimo Updates</h1>
        <p>Current events, server resets, reward codes and official update notes in one compact field board.</p>
      </div>
      <div class={updatesStyles.heroFacts} aria-label="Updates page summary">
        <span><b data-active-event-count>{activeEventCount}</b><small>live events</small></span>
        <span><b>{availableCodes.length}</b><small>listed codes</small></span>
        <span><b>{reviewedLabel}</b><small>last checked</small></span>
      </div>
    </div>
  </div>
</section>

<main class={updatesStyles.updatesPage} data-updates-app data-region={defaultRegion}>
  <nav class={updatesStyles.sectionNav} aria-label="Updates sections"><div class="container"><a href="#now">Now</a><a href="#events">Events</a><a href="#codes">Codes</a><a href="#resets">Resets</a><a href="#archive">Update Archive</a></div></nav>
  <div class="container">
    <section class={updatesStyles.nowBoard} id="now" aria-labelledby="now-title">
      <header class={updatesStyles.sectionHeader}><div><span>Right now</span><h2 id="now-title">Your current Idyll checklist</h2></div><p>APAC is selected first. Switch server once and every event and reset time updates together.</p></header>
      <div class={updatesStyles.nowCards}>
        <article><span class={updatesStyles.nowIcon}>◷</span><div><small>Next daily reset</small><strong data-now-daily>Calculating…</strong><p data-now-daily-local>Your local time</p></div></article>
        <article><span class={updatesStyles.nowIcon}>⌛</span><div><small>Closing first</small><strong data-now-event>{initiallyVisibleEvents[0]?.event.title || "No timed event"}</strong><p data-now-event-time>Checking selected server…</p></div></article>
        <article><span class={updatesStyles.nowIcon}>✦</span><div><small>Newest listed code</small><strong>{availableCodes[0]?.code || "No current code"}</strong><p>{availableCodes[0]?.rewards.slice(0, 2).join(" · ")}</p></div></article>
      </div>
    </section>

    <div class={updatesStyles.primaryGrid}>
      <section class={updatesStyles.eventsPanel} id="events" aria-labelledby="events-title">
        <header class={updatesStyles.panelHeader}>
          <div><span>Happening now</span><h2 id="events-title">Events and deadlines</h2></div>
          <div class={updatesStyles.serverTabs} role="group" aria-label="Choose game server">{resetSchedules.map((server) => <button type="button" data-server={server.region} aria-pressed={server.region === defaultRegion}>{server.label}</button>)}</div>
        </header>
        <p class={updatesStyles.panelIntro}>Times below use the selected server clock. The second line converts each deadline to this device’s local time.</p>
        <div class={updatesStyles.eventList} data-event-list>
          {events.map((event) => {
            const relevant = getRelevantEventPeriod(event, defaultRegion, buildNow);
            const initialStatus = relevant?.state || "expired";
            return <article class={updatesStyles.eventCard} data-event data-periods={JSON.stringify(event.periods)} data-priority={event.priority} data-category={event.category} data-title={event.title} data-state={initialStatus} hidden={!relevant || !initiallyVisibleEvents.some((entry) => entry.event.slug === event.slug)}>
              <div class={updatesStyles.eventTop}><span data-event-category>{event.category}{relevant ? ` · ${relevant.period.label}` : ""}</span><b data-event-status>{initialStatus === "ending" ? "Ending soon" : initialStatus === "live" ? "Live" : "Starts soon"}</b></div>
              <h3>{event.title}</h3><p>{event.summary}</p>
              <div class={updatesStyles.eventTime}><strong data-event-server-time>Loading server window…</strong><small data-event-local-time>Loading your time…</small></div>
              <a href={event.source.href} target="_blank" rel="noopener noreferrer"><span class={updatesStyles.sourceKind} data-kind={event.source.kind}>{event.source.kind === "official" ? "Official" : "Community source"}</span>{event.source.label}<Icon name="external" /></a>
            </article>;
          })}
        </div>
        <p class={updatesStyles.emptyState} data-event-empty hidden>No current or upcoming events are recorded for this server.</p>
      </section>

      <section class={updatesStyles.resetPanel} id="resets" aria-labelledby="resets-title">
        <header class={updatesStyles.panelHeader}><div><span>Server clock</span><h2 id="resets-title">Reset timers</h2></div><b data-selected-server>APAC · UTC+8</b></header>
        <p class={updatesStyles.panelIntro}>Server clocks stay on fixed UTC offsets. Daylight saving may change how these times appear on your device.</p>
        <div class={updatesStyles.resetList}>
          <article data-reset="daily"><span>Daily</span><strong data-countdown>--d --h --m --s</strong><p><b data-reset-utc>04:00 server time</b><small data-reset-local>Your time</small></p></article>
          <article data-reset="weekly"><span>Weekly</span><strong data-countdown>--d --h --m --s</strong><p><b data-reset-utc>Monday 04:00</b><small data-reset-local>Your time</small></p></article>
          <article data-reset="season"><span>Season part</span><strong data-countdown>--d --h --m --s</strong><p><b data-season-label>{initialSeason?.boundary.label || "Next season date not published"}</b><small data-reset-local>{initialSeason ? "Your time" : "Check official notices for the next schedule"}</small></p></article>
        </div>
        <a class={updatesStyles.panelSource} href={seasonBoundaries[0].source.href} target="_blank" rel="noopener noreferrer"><span class={updatesStyles.sourceKind} data-kind="community">Community source</span> Reset rules and season boundary <Icon name="external" /></a>
      </section>
    </div>

    <section class={updatesStyles.codesPanel} id="codes" aria-labelledby="codes-title">
      <header class={updatesStyles.sectionHeader}><div><span>Rewards</span><h2 id="codes-title">Listed reward codes</h2></div><p>No expiry is published for most codes. “Listed” means present in the reviewed directory, so redeem promptly and trust the in-game result.</p></header>
      <div class={updatesStyles.codeGrid}>{availableCodes.map((entry) => <article class={updatesStyles.codeCard}>
        <div><span>Listed</span><small>Added {dateLabel(entry.addedAt)}</small></div><code>{entry.code}</code><p>{entry.rewards.join(" · ")}</p>
        <button type="button" data-copy-code={entry.code} aria-label={`Copy code ${entry.code}`}><Icon name="copy" /><span>Copy code</span></button>
      </article>)}</div>
      {expiredCodes.length > 0 && <details class={updatesStyles.expiredCodes}><summary>Expired codes ({expiredCodes.length})</summary><div>{expiredCodes.map((entry) => <article><code>{entry.code}</code><span>{entry.rewards.join(" · ")}</span></article>)}</div></details>}
      <a class={updatesStyles.panelSource} href={availableCodes[0]?.source.href} target="_blank" rel="noopener noreferrer"><span class={updatesStyles.sourceKind} data-kind="community">Community source</span> Code directory reviewed {reviewedLabel} <Icon name="external" /></a>
    </section>

    <section class={updatesStyles.latestPanel} aria-labelledby="latest-title">
      <div class={updatesStyles.latestArtwork}><Image src={latestUpdate.image} alt="Aniimo world landscape" width={960} height={540} sizes="(max-width: 760px) 100vw, 42vw" /></div>
      <article><div><span>{latestUpdate.label}</span><time datetime={latestUpdate.publishedAt}>{dateLabel(latestUpdate.publishedAt)}</time></div><h2 id="latest-title">{latestUpdate.title}</h2><p>{latestUpdate.summary}</p><a href={latestUpdate.href} target="_blank" rel="noopener noreferrer">Read the official announcement <Icon name="external" /></a></article>
    </section>

    <section class={updatesStyles.archivePanel} id="archive" aria-labelledby="archive-title">
      <header class={updatesStyles.sectionHeader}><div><span>Release ledger</span><h2 id="archive-title">Update archive</h2></div><div class={updatesStyles.archiveFilters} role="group" aria-label="Filter update archive">{(["all", "patch", "event", "notice"] as const).map((kind) => <button type="button" data-update-filter={kind} aria-pressed={kind === "all"}>{kind === "all" ? "All" : kind[0].toUpperCase() + kind.slice(1)}</button>)}</div></header>
      <div class={updatesStyles.archiveList}>{archiveEntries.map((entry) => <article data-update-entry data-kind={entry.kind}>
        <time datetime={entry.publishedAt}>{dateLabel(entry.publishedAt)}</time><div class={updatesStyles.archiveArtwork}><Image src={entry.image} alt="" width={64} height={64} sizes="64px" /></div>
        <div><span>{entry.label}</span><h3>{entry.title}</h3><p>{entry.summary}</p></div><a href={entry.href} target="_blank" rel="noopener noreferrer" aria-label={`Read ${entry.title}`}><Icon name="external" /></a>
      </article>)}</div>
      <p class={updatesStyles.emptyState} data-archive-empty hidden>No records match this filter.</p>
    </section>

    <section class={updatesStyles.sourcesPanel} aria-labelledby="sources-title">
      <div><span>Sources & freshness</span><h2 id="sources-title">Checked against official notices first</h2><p>Official announcements supply patch and event windows. Community directories fill gaps for codes and reset schedules, and are labeled on every affected section.</p></div>
      <ul>{updatesSources.filter((source, index, list) => list.findIndex((entry) => entry.href === source.href) === index).map((source) => <li><a href={source.href} target="_blank" rel="noopener noreferrer"><span class={updatesStyles.sourceKind} data-kind={source.kind}>{source.kind}</span>{source.label}<Icon name="external" /></a></li>)}</ul>
      <p>Last reviewed <time datetime={updatesReviewedAt}>{reviewedLabel}</time>. Always confirm time-sensitive rewards in game.</p>
    </section>
  </div>
  <script type="application/json" data-reset-schedules set:html={JSON.stringify(resetSchedules).replace(/</g, "\\u003c")} />
  <script type="application/json" data-season-boundaries set:html={JSON.stringify(seasonBoundaries).replace(/</g, "\\u003c")} />
</main>

<script>
  import { compareRelevantEvents, getCurrentSeasonBoundary, getNextReset, getRelevantEventPeriod, type EventPeriod, type ResetScheduleRecord, type SeasonBoundaryRecord, type ServerRegion } from "@/lib/update-schedule";

  const app = document.querySelector<HTMLElement>("[data-updates-app]");
  if (app) {
    const schedules = JSON.parse(app.querySelector<HTMLScriptElement>("[data-reset-schedules]")?.textContent || "[]") as ResetScheduleRecord[];
    const boundaries = JSON.parse(app.querySelector<HTMLScriptElement>("[data-season-boundaries]")?.textContent || "[]") as SeasonBoundaryRecord[];
    let region = (app.dataset.region || "apac") as ServerRegion;
    const pad = (value: number) => String(value).padStart(2, "0");
    const countdown = (target: number, now: number) => {
      const remaining = Math.max(0, target - now);
      const days = Math.floor(remaining / 86400000);
      const hours = Math.floor((remaining % 86400000) / 3600000);
      const minutes = Math.floor((remaining % 3600000) / 60000);
      const seconds = Math.floor((remaining % 60000) / 1000);
      return `${days}d ${pad(hours)}h ${pad(minutes)}m ${pad(seconds)}s`;
    };
    const safeFormat = (timestamp: number, formatter: Intl.DateTimeFormat) => Number.isFinite(timestamp) ? formatter.format(new Date(timestamp)) : "Date unavailable";
    const localFormatter = new Intl.DateTimeFormat(undefined, { month: "short", day: "numeric", hour: "numeric", minute: "2-digit", timeZoneName: "short" });
    const utcFormatter = new Intl.DateTimeFormat("en-GB", { weekday: "short", month: "short", day: "numeric", hour: "2-digit", minute: "2-digit", timeZone: "UTC", hour12: false });
    const localDateTime = (timestamp: number) => safeFormat(timestamp, localFormatter);
    const utcDateTime = (timestamp: number) => `${safeFormat(timestamp, utcFormatter)} UTC`;
    const serverDateTime = (timestamp: number, offset: number) => safeFormat(timestamp + offset * 60000, new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", hour: "numeric", minute: "2-digit", timeZone: "UTC" }));

    const render = () => {
      const now = Date.now();
      const schedule = schedules.find((entry) => entry.region === region) || schedules[0];
      if (!schedule) return;
      app.dataset.region = region;
      app.querySelectorAll<HTMLButtonElement>("[data-server]").forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.server === region)));
      const sign = schedule.utcOffsetMinutes >= 0 ? "+" : "-";
      const selected = app.querySelector<HTMLElement>("[data-selected-server]");
      if (selected) selected.textContent = `${schedule.label} / UTC${sign}${Math.abs(schedule.utcOffsetMinutes / 60)}`;
      const daily = getNextReset(schedule, false, now);
      const weekly = getNextReset(schedule, true, now);
      for (const [key, target] of Object.entries({ daily, weekly })) {
        const card = app.querySelector<HTMLElement>(`[data-reset="${key}"]`);
        const clock = card?.querySelector<HTMLElement>("[data-countdown]");
        const utc = card?.querySelector<HTMLElement>("[data-reset-utc]");
        const local = card?.querySelector<HTMLElement>("[data-reset-local]");
        if (clock) clock.textContent = Number.isFinite(target) ? countdown(target, now) : "Date unavailable";
        if (utc) utc.textContent = utcDateTime(target);
        if (local) local.textContent = `Your time / ${localDateTime(target)}`;
      }
      const seasonCard = app.querySelector<HTMLElement>('[data-reset="season"]');
      const season = getCurrentSeasonBoundary(boundaries, now);
      const seasonClock = seasonCard?.querySelector<HTMLElement>("[data-countdown]");
      const seasonLabel = seasonCard?.querySelector<HTMLElement>("[data-season-label]");
      const seasonLocal = seasonCard?.querySelector<HTMLElement>("[data-reset-local]");
      if (season) {
        if (seasonClock) seasonClock.textContent = countdown(season.target, now);
        if (seasonLabel) seasonLabel.textContent = season.boundary.label;
        if (seasonLocal) seasonLocal.textContent = `Your time / ${localDateTime(season.target)}`;
      } else {
        if (seasonClock) seasonClock.textContent = "Schedule unavailable";
        if (seasonLabel) seasonLabel.textContent = "Next season date not published";
        if (seasonLocal) seasonLocal.textContent = "Check official notices for the next schedule";
      }
      const nowDaily = app.querySelector<HTMLElement>("[data-now-daily]");
      const nowDailyLocal = app.querySelector<HTMLElement>("[data-now-daily-local]");
      if (nowDaily) nowDaily.textContent = countdown(daily, now);
      if (nowDailyLocal) nowDailyLocal.textContent = localDateTime(daily);

      const candidates: Array<{ card: HTMLElement; event: { priority: "today" | "week" | "season"; periods: EventPeriod[] }; relevant: NonNullable<ReturnType<typeof getRelevantEventPeriod>> }> = [];
      app.querySelectorAll<HTMLElement>("[data-event]").forEach((card) => {
        try {
          const event = { priority: (card.dataset.priority || "week") as "today" | "week" | "season", periods: JSON.parse(card.dataset.periods || "[]") as EventPeriod[] };
          const relevant = getRelevantEventPeriod(event, region, now);
          if (relevant) candidates.push({ card, event, relevant });
        } catch {
          card.hidden = true;
          card.dataset.state = "invalid";
        }
      });
      candidates.sort(compareRelevantEvents);
      const eventList = app.querySelector<HTMLElement>("[data-event-list]");
      app.querySelectorAll<HTMLElement>("[data-event]").forEach((card) => { card.hidden = true; });
      candidates.slice(0, 8).forEach(({ card, relevant }) => {
        card.hidden = false;
        card.dataset.state = relevant.state;
        eventList?.append(card);
        const status = card.querySelector<HTMLElement>("[data-event-status]");
        const category = card.querySelector<HTMLElement>("[data-event-category]");
        const serverTime = card.querySelector<HTMLElement>("[data-event-server-time]");
        const localTime = card.querySelector<HTMLElement>("[data-event-local-time]");
        const start = Date.parse(relevant.window.startsAt);
        const end = relevant.window.endsAt ? Date.parse(relevant.window.endsAt) : Number.POSITIVE_INFINITY;
        if (status) status.textContent = relevant.state === "ending" ? "Ending soon" : relevant.state === "live" ? "Live" : "Starts soon";
        if (category) category.textContent = `${card.dataset.category} / ${relevant.period.label}`;
        if (serverTime) serverTime.textContent = relevant.window.endsAt ? `${serverDateTime(start, schedule.utcOffsetMinutes)} - ${serverDateTime(end, schedule.utcOffsetMinutes)} / ${schedule.label}` : `From ${serverDateTime(start, schedule.utcOffsetMinutes)} / ${schedule.label}`;
        if (localTime) localTime.textContent = relevant.window.endsAt ? `Your time / ends ${localDateTime(end)}` : `Your time / starts ${localDateTime(start)}`;
      });
      const active = candidates.filter(({ relevant }) => relevant.state === "live" || relevant.state === "ending");
      const closing = active.filter(({ relevant }) => Number.isFinite(relevant.target)).sort((a, b) => a.relevant.target - b.relevant.target)[0];
      const activeCount = document.querySelector<HTMLElement>("[data-active-event-count]");
      const empty = app.querySelector<HTMLElement>("[data-event-empty]");
      const nowEvent = app.querySelector<HTMLElement>("[data-now-event]");
      const nowEventTime = app.querySelector<HTMLElement>("[data-now-event-time]");
      if (activeCount) activeCount.textContent = String(active.length);
      if (empty) empty.hidden = candidates.length > 0;
      if (nowEvent) nowEvent.textContent = closing?.card.dataset.title || "No active deadline";
      if (nowEventTime) nowEventTime.textContent = closing ? `${countdown(closing.relevant.target, now)} remaining` : "Check upcoming events below";
    };

    app.addEventListener("click", async (event) => {
      const target = event.target as Element;
      const server = target.closest<HTMLButtonElement>("[data-server]");
      const filter = target.closest<HTMLButtonElement>("[data-update-filter]");
      const copy = target.closest<HTMLButtonElement>("[data-copy-code]");
      if (server) { region = server.dataset.server as ServerRegion; render(); }
      if (filter) {
        const value = filter.dataset.updateFilter || "all";
        app.querySelectorAll<HTMLButtonElement>("[data-update-filter]").forEach((button) => button.setAttribute("aria-pressed", String(button === filter)));
        let visible = 0;
        app.querySelectorAll<HTMLElement>("[data-update-entry]").forEach((entry) => { entry.hidden = value !== "all" && entry.dataset.kind !== value; if (!entry.hidden) visible++; });
        const empty = app.querySelector<HTMLElement>("[data-archive-empty]");
        if (empty) empty.hidden = visible > 0;
      }
      if (copy) {
        const code = copy.dataset.copyCode || "";
        try { await navigator.clipboard.writeText(code); }
        catch {
          const input = document.createElement("textarea");
          input.value = code;
          document.body.append(input);
          input.select();
          document.execCommand("copy");
          input.remove();
        }
        const label = copy.querySelector("span");
        if (label) label.textContent = "Copied";
        window.setTimeout(() => { if (label) label.textContent = "Copy code"; }, 1800);
      }
    });
    render();
    window.setInterval(render, 1000);
  }
</script>
