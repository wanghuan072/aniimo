---
import { alphaBossSlugs, omegaBosses } from "@/data/editorial/encounters";
import { aniimo, communityDatabase, getDatabaseCategory, mapLocations } from "@/lib/data";
import { groupedSkills, groupedTraits, recordSlug } from "@/lib/database-relations";
import { mapHref, resolveMapFocus } from "@/lib/map-atlas";
import { databaseGuideCues } from "@/lib/guide-hub";
import { elementMeta } from "@/config/site";
import { skillStatChips } from "@/lib/skill-display";
import Breadcrumb from "@/components/astro/Breadcrumb.astro";
import GuideCue from "@/components/astro/GuideCue.astro";
import HeroPanel from "@/components/astro/HeroPanel.astro";
import CatalogStamps from "@/components/astro/CatalogStamps.astro";
import TypeMatchupTable from "@/components/astro/TypeMatchupTable.astro";
import Link from "@/components/astro/Link.astro";
import Image from "@/components/astro/Image.astro";
import Icon from "@/components/astro/Icon.astro";
import styles from "@/style/page/content.module.css";
type Props = { slug: string };
const { slug } = Astro.props;
const category = getDatabaseCategory(slug)!;
const traits = groupedTraits.map((trait) => ({ id: trait.id, name: trait.name, description: trait.description, meta: trait.owners.length > 1 ? `Shared by ${trait.owners.length} Aniimo` : "Used by 1 Aniimo", image: trait.iconUrl, owners: trait.owners }));
const habitats = [...new Set(aniimo.flatMap((entry) => entry.habitats))].sort().map((habitat) => { const name = habitat.replace(/[.]$/, ""); return { name, location: mapLocations.find((location) => location.name.replace(/[.]$/, "").toLowerCase() === name.toLowerCase()), entries: aniimo.filter((entry) => entry.habitats.includes(habitat)) }; });
const byName = new Map(aniimo.map((entry) => [entry.name.replace(/[.]/g, "").toLowerCase(), entry]));
const evolutions = [...new Map(aniimo.filter((entry) => entry.evolution.length > 1).map((entry) => { const nodes = entry.evolution.map((node) => { const linked = byName.get(node.name.replace(/[.]/g, "").toLowerCase()); return { name: node.name, stage: node.stage, image: linked?.voteImage || linked?.image, href: linked ? `/aniimo/${linked.slug}` : undefined }; }); return [nodes.map((node) => `${node.stage}:${node.name}`).join("|"), nodes]; })).values()];
const elements = [...new Set(aniimo.flatMap((entry) => entry.elements))].sort().map((element) => ({ element, entries: aniimo.filter((entry) => entry.elements.includes(element)) }));
const mobility = [...new Set(aniimo.flatMap((entry) => [...entry.mobility.map((ability) => ability.name), ...entry.pathfinding]))].sort().map((ability) => ({ ability, entries: aniimo.filter((entry) => entry.mobility.some((item) => item.name === ability) || entry.pathfinding.includes(ability)), description: aniimo.flatMap((entry) => entry.mobility.filter((item) => item.name === ability).map((item) => item.description))[0] || "Published pathfinding ability.", iconUrl: aniimo.flatMap((entry) => entry.mobility.filter((item) => item.name === ability).map((item) => item.iconUrl))[0] || "" }));
const community = communityDatabase[slug] || [];
const bosses = [...omegaBosses.map((boss) => ({ entry: aniimo.find((entry) => entry.slug === boss.slug)!, rank: "Omega", region: boss.region, unlock: boss.unlock })), ...alphaBossSlugs.map((bossSlug) => ({ entry: aniimo.find((entry) => entry.slug === bossSlug)!, rank: "Alpha", region: "", unlock: "" }))];
const itemCategories = [...new Set(community.map((record) => record.category))].sort();
const materialRarities = [...new Set(community.map((record) => record.rarity))].sort((a, b) => ["Common", "Uncommon", "Rare", "Epic", "Legendary"].indexOf(a) - ["Common", "Uncommon", "Rare", "Epic", "Legendary"].indexOf(b));
const stageLabel = (stage: number) => stage === 1 ? "Lumin" : stage === 2 ? "Gamma" : stage === 3 ? "Nova" : "Special";
const formatAchievement = (description: string) => description.replace(/^→\s*/, "").replace(/(\d+)\s*tiers?(?:gold|prismatic)?/gi, "").replace(/Not available in this version\./gi, "").replace(/([a-z])([A-Z])/g, "$1. $2").trim();
---
<section class={styles.compactHero}><div class="container"><Breadcrumb items={[{ label: "Database", href: "/database" }, { label: category.name }]} /><span class={styles.kicker}><Icon name="database" /> Explore connections</span><h1>Aniimo {category.name}</h1><p>{category.description}</p><HeroPanel label="Use this page" items={["Scan the entries", "Open connected Aniimo", "Keep your next choice focused"]} /></div></section>
<section class={styles.contentSection}><div class="container" data-database-list>
  <GuideCue title="How to use these records" items={databaseGuideCues[slug] || []} />
  {slug === "skills" && <><div class={styles.skillGrid}>{groupedSkills.map((record, index) => <article class={styles.skillCard} data-catalog-record hidden={index >= 60}><span class={styles.skillArtwork}>{record.iconUrl ? <Image src={record.iconUrl} alt="" width={84} height={84} /> : "✦"}</span><div class={styles.skillCardCopy}><h2>{record.name}</h2><small>{[record.category, record.teamRole].filter(Boolean).join(" · ")}</small><dl class={styles.skillStats}>{skillStatChips(record).map((chip) => <div><dt>{chip.label}</dt><dd>{chip.value}</dd></div>)}</dl><p>{record.description}</p></div><div class={styles.skillCardFooter}><span class={styles.skillUsage}>{record.owners.length === 1 ? "Used by 1 Aniimo" : `Used by ${record.owners.length} Aniimo`}</span><span class={styles.skillOwnerList}>{record.owners.map((owner) => <Link href={`/aniimo/${owner.slug}`} title={owner.name} aria-label={`Open ${owner.name}`}><span><Image src={owner.image} alt="" fill sizes="30px" /></span></Link>)}</span></div></article>)}</div><div class={styles.loadMore} aria-live="polite" data-catalog-more><span>Showing 60 of {groupedSkills.length} skills</span><button type="button">Load more <Icon name="arrow" /></button></div></>}
  {slug === "traits" && <><div class={styles.recordList}>{traits.map((record, index) => <article id={record.id} data-catalog-record hidden={index >= 60}><div><span class={styles.recordImage}>{record.image ? <Image src={record.image} alt="" width={44} height={44} /> : "◇"}</span><span><h2>{record.name}</h2><small>{record.meta}</small></span></div><p>{record.description}</p><span class={styles.ownerLinks}>{record.owners.map((owner) => <Link href={`/aniimo/${owner.slug}`} title={owner.name} aria-label={`Open ${owner.name}`}><span><Image src={owner.image} alt="" fill sizes="22px" /></span></Link>)}</span></article>)}</div><div class={styles.loadMore} aria-live="polite" data-catalog-more><span>Showing 60 of {traits.length} traits</span><button type="button">Load more <Icon name="arrow" /></button></div></>}
  {slug === "elements" && <><nav class={styles.typeJump} aria-label="Jump to element">{elements.map((record) => { const meta = elementMeta[record.element]; return <a href={`#${record.element}`} style={{ "--element-color": meta?.color || "#4d83d9", "--element-sprite-index": String(meta?.spriteIndex ?? 0) }}><span class={styles.elementSprite} aria-hidden="true" />{meta?.label || record.element}</a>; })}</nav><div class={styles.catalogBar}><p><strong>{elements.length}</strong> elements <span /> <strong>{aniimo.length}</strong> Aniimo to explore</p><span class={styles.catalogLinks}><Link href="#matchups">Type chart <Icon name="arrow" /></Link><Link href="/aniimo">Find Aniimo by element <Icon name="arrow" /></Link></span></div><div class={styles.typeIndex}>{elements.map((record) => { const meta = elementMeta[record.element]; const label = meta?.label || record.element; return <article id={record.element} class={styles.typePlate} style={{ "--element-color": meta?.color || "#4d83d9", "--element-sprite-index": String(meta?.spriteIndex ?? 0) }}><header><span class={styles.elementSprite} aria-hidden="true" /><div><h2>{label}</h2><p>{record.entries.length} Aniimo</p></div></header><CatalogStamps entries={record.entries.map((entry) => ({ slug: entry.slug, name: entry.name, image: entry.voteImage || entry.image }))} /><Link class={styles.catalogFollow} href={`/aniimo?element=${record.element}`}>See {label} Aniimo <Icon name="arrow" /></Link></article>; })}</div><TypeMatchupTable /></>}
  {slug === "habitats" && <><div class={styles.catalogBar}><p><strong>{habitats.length}</strong> habitat areas <span /> <strong>{habitats.reduce((total, record) => total + record.entries.length, 0)}</strong> connections</p><Link href="/map">Open map <Icon name="arrow" /></Link></div><div class={styles.placeIndex}>{habitats.map((record) => <article id={record.location?.id || record.name} class={styles.placePlate}><header><span class={styles.placeMark} aria-hidden="true"><Image src={record.entries[0].voteImage || record.entries[0].image} alt="" fill sizes="52px" /></span><div><h2>{record.name}</h2><p>{record.entries.length} Aniimo recorded here</p></div></header><CatalogStamps entries={record.entries.map((entry) => ({ slug: entry.slug, name: entry.name, image: entry.voteImage || entry.image }))} /><Link class={styles.catalogFollow} href={mapHref({ region: record.location?.id || record.name })}>View {record.name} on map <Icon name="arrow" /></Link></article>)}</div></>}
  {slug === "evolutions" && <><div class={styles.catalogBar}><p><strong>{evolutions.length}</strong> lineages <span /> <strong>{new Set(evolutions.flatMap((nodes) => nodes.map((node) => node.href || node.name))).size}</strong> Aniimo on a path</p><span>Read each line left to right. A stage with two medals is a real branch.</span></div><div class={styles.lineageIndex}>{evolutions.map((nodes) => { const stages = [...new Map(nodes.map((node) => [node.stage, nodes.filter((candidate) => candidate.stage === node.stage)])).entries()]; const root = stages[0]?.[1][0]; return <article class={styles.lineageRow}><header><h2>{root?.name || "Aniimo"} line</h2><p>{stages.length} stage{stages.length === 1 ? "" : "s"}{nodes.length > stages.length ? " · branches" : ""}</p></header><ol class={styles.lineageFlow} aria-label={`${root?.name || "Aniimo"} evolution path`}>{stages.map(([stage, stageNodes], index) => <li class={styles.lineageStep}>{index > 0 && <span class={styles.lineageArrow} aria-hidden="true"><Icon name="arrow" /></span>}<div><span>{stageLabel(stage)}</span><div class={styles.lineageMedals}>{stageNodes.map((node) => node.href ? <Link href={node.href} aria-label={`Open ${node.name}`}><span class={styles.lineageMedal}>{node.image ? <Image src={node.image} alt="" fill sizes="72px" /> : "✦"}</span><b>{node.name}</b></Link> : <span><span class={styles.lineageMedal}>{node.image ? <Image src={node.image} alt="" fill sizes="72px" /> : "✦"}</span><b>{node.name}</b></span>)}</div></div></li>)}</ol></article>; })}</div></>}
  {slug === "mobility" && <><div class={styles.catalogBar}><p><strong>{mobility.length}</strong> mobility records</p><span>Icons and owners come from published Aniimo kits.</span></div><div class={styles.moveIndex}>{mobility.map((record) => <article id={recordSlug(record.ability)} class={styles.movePlate}><span class={`${styles.moveIcon} ${record.iconUrl ? styles.moveGlyph : ""}`}>{record.iconUrl ? <Image src={record.iconUrl} alt="" width={44} height={44} /> : <Image src={record.entries[0].voteImage || record.entries[0].image} alt="" fill sizes="56px" />}</span><div><h2>{record.ability}</h2><p>{record.description}</p><CatalogStamps entries={record.entries.map((entry) => ({ slug: entry.slug, name: entry.name, image: entry.voteImage || entry.image }))} /></div></article>)}</div></>}
  {(slug === "items" || slug === "materials" || slug === "achievements") && <div data-community-catalog={slug}>
    {slug === "items" && <><div class={styles.itemCatalogueBar}><p><strong data-filter-count>{community.length}</strong> catalogued items <span /> browse by item family</p><span>Images and descriptions are loaded as you browse.</span></div><nav class={styles.itemCategoryFilter} aria-label="Item categories"><button type="button" data-category="all" class={styles.itemCategoryActive}>All items <b>{community.length}</b></button>{itemCategories.map((value) => <button type="button" data-category={value}>{value} <b>{community.filter((record) => record.category === value).length}</b></button>)}</nav><div class={styles.itemCatalogueGrid}>{community.map((record, index) => <article id={record.slug} class={styles.itemCatalogueCard} data-catalog-record data-name={record.name.toLowerCase()} data-category={record.category} hidden={index >= 60}><div class={styles.itemArtwork}><span>{record.image ? <Image src={record.image} alt="" fill sizes="(max-width: 680px) 45vw, 220px" /> : <Icon name="item" />}</span><b>{record.rarity}</b></div><div class={styles.itemCatalogueCopy}><h2>{record.name}</h2><p>{record.description}</p></div></article>)}</div></>}
    {slug === "materials" && <><div class={styles.materialInventoryBar}><p><strong data-filter-count>{community.length}</strong> collected materials <span /> filter by rarity</p><span>Material names and descriptions are shown from the indexed catalogue.</span></div><nav class={styles.materialRarityFilter} aria-label="Material rarity"><button type="button" data-rarity="all" class={styles.materialRarityActive}>All materials <b>{community.length}</b></button>{materialRarities.map((value) => <button type="button" data-rarity={value}>{value} <b>{community.filter((record) => record.rarity === value).length}</b></button>)}</nav><div class={styles.materialInventoryGrid}>{community.map((record, index) => <article class={styles.materialInventoryCard} data-catalog-record data-name={record.name.toLowerCase()} data-rarity={record.rarity} hidden={index >= 60}><span class={styles.materialImage}>{record.image ? <Image src={record.image} alt="" fill sizes="76px" /> : <Icon name="item" />}</span><div><small>{record.rarity}</small><h2 title={record.name}>{record.name}</h2><p>{record.description}</p></div></article>)}</div></>}
    {slug === "achievements" && <><div class={styles.achievementArchiveBar}><p><strong data-filter-count>{community.length}</strong> achievement badges <span /> <b>31</b> badge lines</p><span>Browse the indexed badge archive.</span></div><div class={styles.achievementGrid}>{community.map((record, index) => <article class={styles.achievementCard} data-catalog-record data-name={record.name.toLowerCase()} hidden={index >= 60}><span class={styles.achievementSeal}>{record.image ? <Image src={record.image} alt="" fill sizes="76px" /> : <Icon name="boss" />}</span><div><small>{record.description.match(/(\d+)\s*tiers?/i)?.[1] ? `${record.description.match(/(\d+)\s*tiers?/i)?.[1]} tiers` : "Achievement"}</small><h2 title={record.name}>{record.name}</h2><p>{formatAchievement(record.description)}</p><em>{record.rarity}</em></div></article>)}</div></>}
    <div class={styles.loadMore} aria-live="polite" data-catalog-more><span>Showing {Math.min(60, community.length)} of {community.length} records</span><button type="button">Load more <Icon name="arrow" /></button></div>
  </div>}
  {slug === "bosses" && <><div class={styles.catalogBar}><p><strong>{bosses.length}</strong> encounters <span /> <b>{omegaBosses.length}</b> Omega <span /> <b>{alphaBossSlugs.length}</b> Alpha</p><span>Open a profile, or jump to the marker on the map.</span></div>{(["Omega", "Alpha"] as const).map((rank) => <section class={styles.encounterBand}><header><span>{rank}</span><h2>{rank === "Omega" ? "Quest bosses" : "Field bosses"}</h2></header><div class={rank === "Omega" ? styles.omegaRow : styles.alphaRow}>{bosses.filter((record) => record.rank === rank).map(({ entry, region, unlock }) => { const mapLink = resolveMapFocus(entry.slug) ? mapHref({ marker: entry.slug, region: entry.habitats[0] || region }) : ""; return <article id={entry.slug} class={`${styles.encounterCard} ${rank === "Omega" ? styles.encounterFeatured : ""}`}>{mapLink.includes("?") && <Link class={styles.encounterMap} href={mapLink}><Icon name="pin" /> Map</Link>}<Link class={styles.encounterMain} href={`/aniimo/${entry.slug}`}><span class={styles.encounterArt}><Image src={entry.voteImage || entry.image} alt="" fill sizes={rank === "Omega" ? "280px" : "160px"} /></span><span class={styles.encounterCopy}><small>{rank}{region ? ` · ${region}` : ""}</small><strong>{entry.name}</strong><span class={styles.encounterElements}>{entry.elements.map((element) => <i style={{ "--boss-element": elementMeta[element]?.color || "#5d91c5" }}>{elementMeta[element]?.label || element}</i>)}</span>{unlock ? <em>Quest: {unlock}</em> : entry.habitats.length ? <em>{entry.habitats.slice(0, 2).join(" · ")}</em> : null}</span></Link></article>; })}</div></section>)}</>}
</div></section>
<style is:global>[data-catalog-record][hidden],[data-catalog-more][hidden]{display:none!important}</style>
<script>
  import styles from "@/style/page/content.module.css";
  const root = document.querySelector<HTMLElement>("[data-database-list]");
  if (root) {
    const records = [...root.querySelectorAll<HTMLElement>("[data-catalog-record]")];
    const more = root.querySelector<HTMLElement>("[data-catalog-more]");
    const community = root.querySelector<HTMLElement>("[data-community-catalog]");
    let visible = 60;
    const params = new URLSearchParams(location.search);
    let category = params.get("type") || "all";
    let rarity = params.get("rarity") || "all";
    const query = (params.get("q") || "").toLowerCase();
    const hashIndex = records.findIndex((record) => record.id === location.hash.slice(1));
    if (hashIndex >= 0) visible = Math.max(visible, hashIndex + 1);
    function render() {
      const filtered = records.filter((record) => !community || ((category === "all" || record.dataset.category === category) && (rarity === "all" || record.dataset.rarity === rarity) && (!query || record.dataset.name?.includes(query))));
      for (const record of records) record.hidden = !filtered.includes(record) || filtered.indexOf(record) >= visible;
      if (more) { more.hidden = filtered.length <= visible; more.querySelector("span")!.textContent = `Showing ${Math.min(visible, filtered.length)} of ${filtered.length} ${community ? "records" : location.pathname.endsWith("skills") ? "skills" : "traits"}`; }
      community?.querySelectorAll<HTMLButtonElement>("[data-category],[data-rarity]").forEach((button) => { const active = button.dataset.category === category || button.dataset.rarity === rarity; button.classList.toggle(styles.itemCategoryActive, active && !!button.dataset.category); button.classList.toggle(styles.materialRarityActive, active && !!button.dataset.rarity); });
      const count = community?.querySelector("[data-filter-count]"); if (count) count.textContent = String(filtered.length);
    }
    root.addEventListener("click", (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>("button"); if (!button) return;
      if (button.parentElement?.matches("[data-catalog-more]")) { visible += 60; render(); return; }
      if (button.dataset.category) category = button.dataset.category;
      else if (button.dataset.rarity) rarity = button.dataset.rarity;
      else return;
      visible = 60;
      const url = new URL(location.href);
      if (category === "all") url.searchParams.delete("type"); else url.searchParams.set("type", category);
      if (rarity === "all") url.searchParams.delete("rarity"); else url.searchParams.set("rarity", rarity);
      history.replaceState(null, "", url);
      render();
    });
    render();
    if (hashIndex >= 0) requestAnimationFrame(() => records[hashIndex].scrollIntoView({ block: "start" }));
  }
</script>
