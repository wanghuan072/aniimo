---
import Link from "@/components/astro/Link.astro";
import Image from "@/components/astro/Image.astro";
import { aniimo } from "@/lib/data";
import AniimoExplorer from "@/components/astro/AniimoExplorer.astro";
import Breadcrumb from "@/components/astro/Breadcrumb.astro";
import GuideCue from "@/components/astro/GuideCue.astro";
import { pageGuideCues } from "@/lib/guide-hub";
import Icon from "@/components/astro/Icon.astro";
import UnreleasedAniimo from "@/components/astro/UnreleasedAniimo.astro";
import styles from "@/style/page/content.module.css";
const explorerEntries = aniimo.map((entry) => ({
  slug: entry.slug,
  name: entry.name,
  description: entry.description,
  image: entry.image,
  voteImage: entry.voteImage,
  entryId: entry.entryId,
  stage: entry.stage,
  elements: entry.elements,
  roles: entry.roles,
  form: entry.form,
  viewCount: entry.viewCount,
}));

const novaCount = aniimo.filter((entry) => entry.stage === 3).length;
const electricCount = aniimo.filter((entry) => entry.elements.includes("electric")).length;
const newest = [...aniimo].sort((a, b) => Number(b.entryId) - Number(a.entryId)).slice(0, 4);
const heroAniimo = ["glacy", "leafy", "geoclaw"].map((slug) => aniimo.find((entry) => entry.slug === slug)).filter(Boolean);
---

    <>
      <section class={styles.listHero}>
        <div class={`container ${styles.listHeroInner}`}>
          <div class={styles.listHeroCopy}>
            <Breadcrumb items={[{ label: "Aniimo" }]} />
            <span class={styles.listEyebrow}>Discover · collect · learn</span>
            <h1><span>✦</span> Aniimo Creatures — Browse the Current Index <span>✦</span></h1>
            <p>Filter by element, role and stage, then open a profile to see skills, traits, forms, habitats and evolution paths in one place.</p>
          </div>
          <div class={styles.heroCreatures}>{heroAniimo.map((entry, index) => entry && <Image src={entry.voteImage || entry.image} alt={entry.name} width={250} height={250} style={{ "--creature-index": index }} />)}</div>
          <div class={styles.countBubble}><strong>{aniimo.length}</strong><span>Aniimo</span></div>
        </div>
      </section>
      <section class={styles.listContent}>
        <div class="container">
          <div class={styles.listExplorer}>
            <AniimoExplorer entries={explorerEntries} />
          </div>
          <div class={styles.popularBand}>
            <div class={styles.popularCategories}><h2>✣ Browse Aniimo by Element, Role or Stage</h2><div><Link href="/tier-list/global-vote"><b>★</b><span><strong>Global Vote</strong><small>2026 player results</small></span></Link><Link href="/aniimo?element=electric"><b>ϟ</b><span><strong>Electric</strong><small>{electricCount} Aniimo</small></span></Link><Link href="/aniimo?stage=3"><b>★</b><span><strong>Nova Stage</strong><small>{novaCount} Aniimo</small></span></Link><Link href={`/aniimo/${newest[0]?.slug}`}><b>NEW</b><span><strong>Newer profiles</strong><small>{newest.length} quick links</small></span></Link></div></div>
            <aside><span>✦ Choosing between two?</span><p>Filter by the job your team needs first, then compare the skills and fields that affect that choice.</p><Link href="/tools/compare">Compare Aniimo <Icon name="arrow" /></Link></aside>
          </div>
          <GuideCue title="Related guides" items={pageGuideCues.aniimoIndex} />
          <UnreleasedAniimo />
        </div>
      </section>
    </>
