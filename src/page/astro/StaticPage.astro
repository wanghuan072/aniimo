---
import Breadcrumb from "@/components/astro/Breadcrumb.astro";
import styles from "@/style/page/tools.module.css";
const { title, description } = Astro.props;
---
<section class={styles.toolHeader}><div class="container"><Breadcrumb items={[{ label: title }]} /><h1>{title}</h1><p>{description}</p></div></section>
<section class={styles.toolContent}><div class={`container ${styles.staticCopy}`}><slot /></div></section>
