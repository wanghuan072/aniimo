---
import { typeChart } from "@/lib/data";
import { elementMeta } from "@/config/site";
import styles from "@/style/page/content.module.css";
const orbStyle = (element: string) => ({ "--element-color": elementMeta[element]?.color || "#4d83d9", "--element-sprite-index": String(elementMeta[element]?.spriteIndex ?? 0) });
const cellClass = (value: number) => value === typeChart.superEffective ? styles.chartStrong : value === typeChart.resisted ? styles.chartResist : styles.chartNeutral;
---
<section id="matchups" class={styles.matchupSection} aria-labelledby="matchups-title"><header><div><span class={styles.elementEyebrow}>Matchups</span><h2 id="matchups-title">Type Chart</h2></div><p>Rows attack, columns defend. 1.6 is a strong hit, 1 is neutral, .625 is resisted.</p></header><div class={styles.chartLegend} aria-label="Matchup legend"><span class={styles.chartStrong}>1.6 Super effective</span><span class={styles.chartNeutral}>1 Neutral</span><span class={styles.chartResist}>.625 Resisted</span></div><div class={styles.chartCard}><div class={styles.chartScroller}><table class={styles.typeTable}><caption>Attacker rows versus defender columns</caption><thead><tr><th scope="col"><span class={styles.chartCorner}><b>ATK ↓</b><i>DEF →</i></span></th>{typeChart.elements.map((element) => <th scope="col" title={elementMeta[element]?.label || element}><span class={styles.chartOrb} style={orbStyle(element)} aria-hidden="true" /><span class={styles.chartVisuallyHidden}>{elementMeta[element]?.label || element}</span></th>)}</tr></thead><tbody>{typeChart.elements.map((attacker, row) => <tr><th scope="row"><span class={styles.chartRowHead}><span class={styles.chartOrb} style={orbStyle(attacker)} aria-hidden="true" /><span>{elementMeta[attacker]?.label || attacker}</span></span></th>{typeChart.matrix[row].map((value) => <td class={cellClass(value)}>{value === typeChart.resisted ? ".625" : String(value)}</td>)}</tr>)}</tbody></table></div></div><p class={styles.matchupNote}>Closed Beta 3 matchup table · checked {typeChart.verifiedAt}. Values can change between game versions.</p></section>
