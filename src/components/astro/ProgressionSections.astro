---
import type { AniimoPageData } from "@/lib/aniimo-page-data";
import Link from "@/components/astro/Link.astro";
import { aniimo } from "@/lib/data";

interface Props { name: string; progression: NonNullable<AniimoPageData["progression"]> }
const { name, progression } = Astro.props;
const hasBuild = progression.build.items.length || progression.build.partners.length;
const hasResonance = progression.resonance.stages.length > 0;
const hasResearch = progression.research.topics.length > 0;
const localSlugs = new Set(aniimo.map((entry) => entry.slug));
---
<section class="progression" aria-label={`${name} progression information`}>
  <header class="heading"><div><span>Community data · reviewed {progression.reviewedAt}</span><h2>Build & progression</h2></div><a href={progression.sourceUrl} target="_blank" rel="noopener noreferrer">View source ↗</a></header>
  <p class="caveat">These details come from AniimoVerse’s public Aniilog record. They may differ from older official wiki fields shown elsewhere on this page. Check the game before spending scarce materials.</p>
  <div class="grid">
    {hasBuild && <article class="card"><h3>Recommended build</h3><p class="intro">Suggested by the referenced Aniilog record; item effects and form fit need individual review.</p>{progression.build.items.length > 0 && <><h4>Carried items</h4><ul>{progression.build.items.map((item) => <li><a href={item.url} target="_blank" rel="noopener noreferrer">{item.name} ↗</a></li>)}</ul></>}{progression.build.partners.length > 0 && <><h4>Ideal partner</h4><ul>{progression.build.partners.map((partner) => <li>{localSlugs.has(partner.slug) ? <Link href={`/aniimo/${partner.slug}`}>{partner.name}</Link> : <a href={`https://www.aniimoverse.com/aniilog/${partner.slug}`} target="_blank" rel="noopener noreferrer">{partner.name} ↗</a>}</li>)}</ul></>}</article>}
    {hasResonance && <article class="card"><h3>Resonance Training</h3><p class="intro">Stage gates, bonuses and costs for this species profile.</p>{progression.resonance.materials.length > 0 && <div class="materials">{progression.resonance.materials.map((material) => <span><small>{material.kind}</small><a href={material.url} target="_blank" rel="noopener noreferrer">{material.name} ↗</a></span>)}</div>}<ol class="stages">{progression.resonance.stages.map((stage) => <li><strong>Stage {stage.stage}</strong><span>{stage.gate}{stage.bonus ? ` · ${stage.bonus}` : ""}</span>{stage.cost.length > 0 && <small>{stage.cost.join(" · ")}</small>}{stage.levels.length > 0 && <details class="trainingLevels"><summary>{stage.levels.length} training {stage.levels.length === 1 ? "level" : "levels"}</summary><ul>{stage.levels.map((level) => <li><b>Level {level.level}</b><span>{level.gain}</span><small>{level.costs.join(" · ")}</small></li>)}</ul></details>}</li>)}</ol></article>}
    {hasResearch && <article class="card"><h3>Aniimo Research</h3><p class="intro">Each milestone shows the required count and research points awarded.</p><div class="topics">{progression.research.topics.map((topic) => <div><h4>{topic.title}</h4><p>{topic.milestones.length > 0 ? topic.milestones.map((milestone) => `×${milestone.required.toLocaleString()} → +${milestone.points}`).join(" · ") : "See source for milestones"}</p></div>)}</div></article>}
  </div>
</section>
<style>
  .progression{margin:24px 0 0;padding:24px;border:1px solid #cdddec;border-radius:22px;background:#f5faff;color:#213b5b}.heading{display:flex;justify-content:space-between;align-items:end;gap:16px}.heading span{font-size:12px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#527197}.heading h2{margin:4px 0 0;font-size:27px}.heading a,.card a{color:#155caa;font-weight:800;text-decoration:none}.heading a:hover,.card a:hover{text-decoration:underline}.caveat{max-width:80ch;line-height:1.55;color:#536b85}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.card{padding:18px;border:1px solid #d8e5f1;border-radius:16px;background:white}.card h3{margin:0 0 8px;font-size:20px}.card h4{margin:15px 0 5px;font-size:14px}.card ul{margin:0;padding-left:20px;line-height:1.8}.intro{margin:0;color:#60758d;font-size:14px;line-height:1.5}.materials{display:flex;flex-wrap:wrap;gap:7px;margin:16px 0}.materials span{display:flex;flex-direction:column;padding:7px 9px;border-radius:9px;background:#f0f6fc}.materials small{color:#60758d}.stages{margin:0;padding:0;list-style:none}.stages li{display:grid;grid-template-columns:auto 1fr;column-gap:8px;padding:8px 0;border-top:1px solid #e5edf4;font-size:13px}.stages li small{grid-column:2;color:#667e96}.topics>div{padding:9px 0;border-top:1px solid #e5edf4}.topics h4{margin:0}.topics p{margin:3px 0 0;font-size:13px;color:#60758d}@media(max-width:1050px){.grid{grid-template-columns:1fr 1fr}}@media(max-width:700px){.grid{grid-template-columns:1fr}.progression{padding:16px}.heading{align-items:start;flex-direction:column}}
</style>
<style>.trainingLevels{grid-column:1/-1;margin:7px 0 0 48px;color:#466788}.trainingLevels summary{cursor:pointer;font-weight:800}.trainingLevels ul{margin:4px 0;padding:0;list-style:none}.trainingLevels li{display:grid;grid-template-columns:auto 1fr;gap:4px 8px;border-top:1px solid #e5edf4}.trainingLevels li small{grid-column:2}</style>
