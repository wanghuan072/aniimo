---
import type { AniimoStats } from "@/types/content";
import styles from "@/style/page/detail.module.css";
type Props = { stats: AniimoStats };
const { stats } = Astro.props;
const axes = [["HP", stats.hp, "♥"], ["P. ATK", stats.physicalAttack, "⚔"], ["M. ATK", stats.magicAttack, "◆"], ["P. DEF", stats.physicalDefense, "⬟"], ["M. DEF", stats.magicDefense, "◈"], ["REGEN", stats.haste, "ϟ"]] as const;
const point = (value: number, index: number, scale = 1) => {
  const angle = -Math.PI / 2 + index * Math.PI / 3;
  const radius = 69 * scale * Math.min(value, 100) / 100;
  return `${90 + Math.cos(angle) * radius},${90 + Math.sin(angle) * radius}`;
};
const polygon = axes.map(([, value], index) => point(value, index)).join(" ");
const grid = [0.33, 0.66, 1].map((scale) => axes.map((_, index) => point(100, index, scale)).join(" "));
---
<div class={styles.radarWrap}>
  <svg viewBox="0 0 180 180" role="img" aria-label="Radar visualization of official base stat fields">
    {grid.map((points) => <polygon points={points} class={styles.radarGrid} />)}
    {axes.map((_, index) => { const angle = -Math.PI / 2 + index * Math.PI / 3; return <line x1="90" y1="90" x2={90 + Math.cos(angle) * 69} y2={90 + Math.sin(angle) * 69} class={styles.radarAxis} />; })}
    <polygon points={polygon} class={styles.radarValue} />
  </svg>
  <div class={styles.statBars}>{axes.map(([label, value, icon]) => <div class={styles.statRow}><i aria-hidden="true">{icon}</i><span>{label}</span><progress max="100" value={Math.min(value, 100)} aria-label={`${label}: ${value}`} /><strong>{value}</strong></div>)}</div>
</div>
