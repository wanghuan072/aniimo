---
import type { Aniimo } from "@/types/content";
import { placements, tierDetails } from "@/data/editorial/tier-placements";
import { elementMeta, roleLabels } from "@/config/site";
import Link from "./Link.astro";
import Image from "./Image.astro";
import styles from "@/style/page/content.module.css";
type Props = { entries: Aniimo[] };
const { entries } = Astro.props;
const index = new Map(entries.map((entry) => [entry.slug, entry]));
const roles = [...new Set(entries.flatMap((entry) => entry.roles))].sort();
const grouped = (Object.keys(tierDetails) as Array<keyof typeof tierDetails>).map((tier) => ({ tier, details: tierDetails[tier], entries: placements.filter((placement) => placement.tier === tier).map((placement) => index.get(placement.slug)).filter((entry): entry is Aniimo => Boolean(entry)) }));
const ranked = new Set(placements.map((placement) => placement.slug));
const pending = entries.filter((entry) => !ranked.has(entry.slug));
const verdict = (entry: Aniimo) => { const skills = entry.skills.slice(0, 2).map((skill) => skill.name).filter(Boolean); const role = roleLabels[entry.roles[0]] || entry.roles[0] || "team"; return skills.length ? `${role} option with ${skills.join(" and ")}.` : `${role} option with the details you need to compare on its profile.`; };
---
<section class={styles.playerTierBoard} aria-labelledby="tier-board-title" data-tier-board><header class={styles.playerTierHeader}><div><span>Player tier list</span><h2 id="tier-board-title">Choose by the job your team needs</h2></div><p>Roles are compared with their own job in mind. Newly added launch records remain unranked until their placements are reviewed.</p></header><nav class={styles.tierRoleFilters} aria-label="Filter tier list by role"><button type="button" data-role="all" class={styles.tierRoleActive} aria-pressed="true">All roles</button>{roles.map((role) => <button type="button" data-role={role} aria-pressed="false">{roleLabels[role] || role}</button>)}</nav><div class={styles.tierBands}>{grouped.map(({ tier, details, entries: tierEntries }) => <section class={styles.playerTierBand} style={{ "--tier-color": details.color }} data-tier-band><aside><strong>{tier}</strong><span>{details.label}</span><small>{details.note}</small></aside><div>{tierEntries.map((entry) => <Link href={`/aniimo/${entry.slug}`} data-tier-entry data-roles={entry.roles.join(" ")}><span class={styles.playerTierPortrait}><Image src={entry.image} alt="" fill sizes="86px" /></span><span class={styles.playerTierCopy}><b>{entry.name}</b><em>{entry.elements.map((element) => elementMeta[element]?.label || element).join(" / ")} · {entry.roles.map((role) => roleLabels[role] || role).join(" / ")}</em><small>{verdict(entry)}</small></span></Link>)}</div></section>)}{pending.length > 0 && <section class={styles.playerTierBand} style={{ "--tier-color": "#7c91a2" }} data-tier-band><aside><strong>New</strong><span>Awaiting review</span><small>These profiles have source data but no editorial tier placement yet.</small></aside><div>{pending.map((entry) => <Link href={`/aniimo/${entry.slug}`} data-tier-entry data-roles={entry.roles.join(" ")}><span class={styles.playerTierPortrait}><Image src={entry.image} alt="" fill sizes="86px" /></span><span class={styles.playerTierCopy}><b>{entry.name}</b><em>{entry.elements.map((element) => elementMeta[element]?.label || element).join(" / ")} · {entry.roles.map((role) => roleLabels[role] || role).join(" / ")}</em><small>{verdict(entry)}</small></span></Link>)}</div></section>}</div></section>
<style is:global>[data-tier-entry][hidden],[data-tier-band][hidden]{display:none!important}</style>
<script>
  import styles from "@/style/page/content.module.css";
  const board = document.querySelector<HTMLElement>("[data-tier-board]");
  board?.addEventListener("click", (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>("[data-role]");
    if (!button) return;
    const role = button.dataset.role;
    board.querySelectorAll<HTMLButtonElement>("[data-role]").forEach((option) => { const active = option === button; option.classList.toggle(styles.tierRoleActive, active); option.setAttribute("aria-pressed", String(active)); });
    board.querySelectorAll<HTMLElement>("[data-tier-band]").forEach((band) => { let visible = 0; band.querySelectorAll<HTMLElement>("[data-tier-entry]").forEach((entry) => { entry.hidden = role !== "all" && !entry.dataset.roles?.split(" ").includes(role || ""); if (!entry.hidden) visible++; }); band.hidden = visible === 0; });
  });
</script>
